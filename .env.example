# Local Development
# Production-only integrations are disabled here so contributors can run the
# frontend against a local backend without Stripe or other prod credentials.
NEXT_PUBLIC_API_URL=http://localhost:8083/api/v1
# Optional server-side API URL for SSR and Next.js route handlers. In production
# Vault sets this to the Docker-internal backend URL so server-to-server calls do
# not pass through Cloudflare browser challenges.
INTERNAL_API_URL=
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
NEXT_IMAGE_REMOTE_SOURCES=http://localhost:9000,https://fzvwwpzdudxrdzwbucaw.supabase.co

# E2E test seed credentials
E2E_EXISTING_EMAIL=olivia@example.com
E2E_EXISTING_PASSWORD=p@ss1logic11

# Stripe Hosted Checkout UI toggle.
# Keep disabled for normal localhost runs. Set to true only when your local
# backend has STRIPE_ENABLED=true and valid Stripe test-mode keys.
# Use Stripe test cards only: https://docs.stripe.com/testing#cards
NEXT_PUBLIC_STRIPE_ENABLED=false

# Google OAuth sign-in. Requires a valid Google Client ID on the backend.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# AI-powered review summaries. Requires the backend AI service to be configured.
NEXT_PUBLIC_AI_ENABLED=false

# Support chat is production-only and disabled for normal local contributor
# runs. Production enables it through Vault after backend and Telegram runtime
# config are ready.
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=false
# Optional override for the support-chat STOMP endpoint. The target must receive
# the frontend HttpOnly auth cookie; prefer the same public origin/reverse proxy
# path in production.
NEXT_PUBLIC_SUPPORT_CHAT_WS_URL=

# Email confirmation flow (registration code, password reset).
# Keep disabled when the backend has EMAIL_ENABLED=false.
NEXT_PUBLIC_EMAIL_CONFIRMATION_ENABLED=false

# Google Analytics 4 measurement ID (public, optional, disabled when blank).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Observability and Web Vitals (disabled locally by default).
NEXT_PUBLIC_OBSERVABILITY_ENABLED=false
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1
OBSERVABILITY_OTEL_ENABLED=false
OBSERVABILITY_LOG_EVENTS=false
OTEL_SERVICE_NAME=iced-latte-frontend

# Sentry error tracking (disabled locally by default).
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional source map upload during production builds.
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare Turnstile bot protection (disabled locally — leave blank).
# Get keys from: https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SUPPORT_CHAT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_REVIEWS_ENABLED=false
NEXT_PUBLIC_TURNSTILE_AVATAR_ENABLED=false
