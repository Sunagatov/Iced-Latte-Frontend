{
  "name": "iced-latte",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:circular": "madge src --extensions ts,tsx --ts-config tsconfig.json --circular --warning",
    "tsc": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:local": "BASE_URL=http://localhost:3000 playwright test",
    "test:e2e:local-smoke": "BASE_URL=http://localhost:3000 playwright test e2e/local-contributor-smoke.guest.ts --project=guest --retries=0",
    "test:e2e:prod": "node -e \"if (!process.env.BASE_URL) { console.error('Set BASE_URL to the deployed frontend URL'); process.exit(1) }\" && playwright test",
    "test:e2e:report": "playwright show-report",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/shared/api/generated && git diff --cached --exit-code -- src/shared/api/generated && test -z \"$(git ls-files --others --exclude-standard src/shared/api/generated)\""
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.3",
    "@next/third-parties": "^16.4.5",
    "@sentry/nextjs": "11.11.0",
    "@stomp/stompjs": "^7.5.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/otel": "2.3.0",
    "autoprefixer": "^10.6.2",
    "axios": "1.21.0",
    "axios-cache-interceptor": "^1.13.0",
    "next": "16.4.5",
    "postcss": "8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.2.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "yup": "^1.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "orval": "^8.47.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supports-color": "^11.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
