{
  "name": "iced-latte",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:circular": "madge src --extensions ts,tsx --ts-config tsconfig.json --circular --warning",
    "tsc": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:local": "BASE_URL=http://localhost:3000 playwright test",
    "test:e2e:local-smoke": "BASE_URL=http://localhost:3000 playwright test e2e/local-contributor-smoke.guest.ts --project=guest --retries=0",
    "test:e2e:prod": "node -e \"if (!process.env.BASE_URL) { console.error('Set BASE_URL to the deployed frontend URL'); process.exit(1) }\" && playwright test",
    "test:e2e:report": "playwright show-report",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/shared/api/generated && git diff --cached --exit-code -- src/shared/api/generated && test -z \"$(git ls-files --others --exclude-standard src/shared/api/generated)\""
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.5.2",
    "@next/third-parties": "^16.2.6",
    "@sentry/nextjs": "10.56.0",
    "@stomp/stompjs": "^7.3.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/otel": "2.1.2",
    "autoprefixer": "^10",
    "axios": "1.16.1",
    "axios-cache-interceptor": "^1.11.4",
    "next": "16.2.6",
    "postcss": "8.5.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.5",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-testing-library": "^7.16.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^16.3.2",
    "madge": "^8.0.0",
    "orval": "^8.17.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supports-color": "^10.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
